rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ----------------------------------------------------
    // User Profiles
    // ----------------------------------------------------
    match /users/{userId} {
      // Authenticated users can read public profiles for Discovery, Matches, and Calling
      allow read: if isSignedIn();

      // An authenticated user can only create their own profile document matching their auth UID
      allow create: if isOwner(userId) && request.resource.data.userId == userId;

      // An authenticated user can only update their own profile document
      allow update: if isOwner(userId) && request.resource.data.userId == userId;

      // An authenticated user can only delete their own profile
      allow delete: if isOwner(userId);

      // Private subcollection: strictly accessible by the account owner
      // (Used to store verified phone numbers, KYC, private security metadata)
      match /private/{documentId} {
        allow read, write: if isOwner(userId);
      }

      // User notifications
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public User Index (BDXXXXXX -> userId) for searching by Public ID
    match /public_user_indices/{publicUserId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Likes & Passes
    match /likes/{likeId} {
      allow read: if isSignedIn() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.fromUserId == request.auth.uid;
    }

    // Matches
    match /matches/{matchId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.users);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.users);
      allow update: if isSignedIn() && (request.auth.uid in resource.data.users);
      allow delete: if isSignedIn() && (request.auth.uid in resource.data.users);

      // Realtime Messages Subcollection within match
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users);
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn();
        allow delete: if false;
      }
    }

    // 1-on-1 Audio/Video Call Sessions
    match /calls/{callId} {
      allow read: if isSignedIn() && (resource.data.callerUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.callerUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.callerUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.callerUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
    }

    // User Reports (Safety & Anti-Harassment)
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }

    // User Blocks
    match /blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }
  }
}
