rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Core Authentication & Role Validation Helpers
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // 1. Users Collection & Subcollections
    // =========================================================================

    match /users/{userId} {
      // Authenticated users can read profile documents for discovery and matching
      allow read: if isAuthenticated();

      // Users can only create their own profile document
      allow create: if isOwner(userId);

      // Users can update their own profile, but cannot escalate their role to admin
      allow update: if (
        isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          isAdmin()
        )
      ) || isAdmin();

      // Only the profile owner or an authorized admin can delete a user account
      allow delete: if isOwner(userId) || isAdmin();

      // Notifications Subcollection
      match /notifications/{notificationId} {
        allow read, update: if isOwner(userId);
        allow create: if isAuthenticated();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // 2. Public User Search Index
    // =========================================================================

    match /public_user_index/{publicId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // 3. Rejections Collection (48-Hour Discovery Hide Rules)
    // =========================================================================

    match /rejections/{rejectionId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.rejectorUid ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        request.auth.uid == request.resource.data.rejectorUid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource != null && request.auth.uid == resource.data.rejectorUid ||
        isAdmin()
      );
    }

    // =========================================================================
    // 4. Match / Interest Requests Collection
    // =========================================================================

    match /match_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.senderId &&
        request.resource.data.receiverId != request.auth.uid
      );
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId ||
        isAdmin()
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && (
          request.auth.uid == resource.data.senderId ||
          request.auth.uid == resource.data.receiverId
        )
      );
    }

    // =========================================================================
    // 5. Likes Collection
    // =========================================================================

    match /likes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.fromUserId ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        (resource != null && request.auth.uid == resource.data.fromUserId) ||
        isAdmin()
      );
    }

    // =========================================================================
    // 6. Confirmed Matches & Chat Messages
    // =========================================================================

    match /matches/{matchId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid in resource.data.users ||
        request.auth.uid == resource.data.user1Id ||
        request.auth.uid == resource.data.user2Id ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.user1Id ||
        request.auth.uid == request.resource.data.user2Id ||
        request.auth.uid in request.resource.data.users ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.users ||
        request.auth.uid == resource.data.user1Id ||
        request.auth.uid == resource.data.user2Id ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Real-time Chat Messages Subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId;
        allow update: if isAuthenticated();
        allow delete: if isAdmin() || (resource != null && request.auth.uid == resource.data.senderId);
      }
    }

    // =========================================================================
    // 7. WebRTC Calling & P2P Signaling
    // =========================================================================

    match /calls/{callId} {
      function getCallData() {
        return get(/databases/$(database)/documents/calls/$(callId)).data;
      }

      function isCallParticipant() {
        return isAuthenticated() && (
          (resource != null && (
            request.auth.uid == resource.data.callerUid ||
            request.auth.uid == resource.data.receiverUid
          )) ||
          isAdmin()
        );
      }

      function isValidCallCreate() {
        return isAuthenticated() &&
          request.resource.data.callerUid == request.auth.uid &&
          request.resource.data.receiverUid is string &&
          request.resource.data.receiverUid != request.auth.uid &&
          request.resource.data.receiverUid.size() > 0;
      }

      // Read: Only the caller, the receiver, or an authorized admin
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.callerUid ||
        request.auth.uid == resource.data.receiverUid ||
        isAdmin()
      );

      // Create: Authenticated caller initiating a call to a valid distinct receiver
      allow create: if isValidCallCreate();

      // Update: Caller, receiver, or admin updating call status, offer, answer, or duration
      // Prevent changing callerUid or receiverUid to hijack ongoing calls
      allow update: if isAuthenticated() && (
        isCallParticipant() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['callerUid', 'receiverUid'])
      ) || isAdmin();

      // Delete: Participant or admin
      allow delete: if isCallParticipant();

      // WebRTC Caller Candidates Subcollection
      match /callerCandidates/{candidateId} {
        // Read: Caller, receiver, or admin
        allow read: if isAuthenticated() && (
          request.auth.uid == getCallData().callerUid ||
          request.auth.uid == getCallData().receiverUid ||
          isAdmin()
        );

        // Create/Update: Only the caller or an admin
        allow create, update: if isAuthenticated() && (
          request.auth.uid == getCallData().callerUid ||
          isAdmin()
        );

        // Delete: Caller or admin
        allow delete: if isAuthenticated() && (
          request.auth.uid == getCallData().callerUid ||
          isAdmin()
        );
      }

      // WebRTC Receiver Candidates Subcollection
      match /receiverCandidates/{candidateId} {
        // Read: Caller, receiver, or admin
        allow read: if isAuthenticated() && (
          request.auth.uid == getCallData().callerUid ||
          request.auth.uid == getCallData().receiverUid ||
          isAdmin()
        );

        // Create/Update: Only the receiver or an admin
        allow create, update: if isAuthenticated() && (
          request.auth.uid == getCallData().receiverUid ||
          isAdmin()
        );

        // Delete: Receiver or admin
        allow delete: if isAuthenticated() && (
          request.auth.uid == getCallData().receiverUid ||
          isAdmin()
        );
      }
    }

    // =========================================================================
    // 8. User Blocking Collection
    // =========================================================================

    match /blocks/{blockId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.blockerUid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.blockerUid ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        (resource != null && request.auth.uid == resource.data.blockerUid) ||
        isAdmin()
      );
    }

    // =========================================================================
    // 9. User Reports Collection
    // =========================================================================

    match /reports/{reportId} {
      // Any authenticated user can submit a report against a violating account
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.reporterUid ||
        isAdmin()
      );

      // Only authorized admins can review, update, or dismiss reports
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // 10. User Sessions & Analytics Tracking
    // =========================================================================

    match /user_sessions/{sessionId} {
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow read: if isAdmin() || (resource != null && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 11. Admin Audit Logs
    // =========================================================================

    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
