rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.publicUserId is string && data.publicUserId.size() <= 32 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.age is int && data.age >= 18 && data.age <= 120 &&
             data.accountStatus is string && data.accountStatus in ['active', 'suspended', 'deleted'] &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
             (!('gender' in data) || (data.gender is string && data.gender in ['Male', 'Female', 'Man', 'Woman'])) &&
             (!('dob' in data) || (data.dob is string && data.dob.size() <= 30)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('state' in data) || (data.state is string && data.state.size() <= 100)) &&
             (!('datingPreference' in data) || (data.datingPreference is string && data.datingPreference.size() <= 100)) &&
             (!('maskedMobileNumber' in data) || (data.maskedMobileNumber is string && data.maskedMobileNumber.size() <= 30)) &&
             (!('isMobileVerified' in data) || data.isMobileVerified is bool) &&
             (!('rulesAccepted' in data) || data.rulesAccepted is bool) &&
             (!('profileCompleted' in data) || data.profileCompleted is bool) &&
             (!('totalPhotoCount' in data) || (data.totalPhotoCount is int && data.totalPhotoCount >= 0)) &&
             (!('verificationStatus' in data) || (data.verificationStatus is string && data.verificationStatus in ['verified', 'unverified', 'pending'])) &&
             (!('allowCallsFrom' in data) || (data.allowCallsFrom is string && data.allowCallsFrom in ['matches', 'everyone', 'none'])) &&
             (!('showOnlineStatus' in data) || data.showOnlineStatus is bool) &&
             (!('isPremium' in data) || data.isPremium is bool) &&
             (!('interests' in data) || (data.interests is list && data.interests.size() <= 30)) &&
             (!('profilePhotoUrls' in data) || (data.profilePhotoUrls is list && data.profilePhotoUrls.size() <= 10)) &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt)) &&
             (!('lastActiveAt' in data) || isValidTimestamp(data.lastActiveAt));
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isUser(userId) && isValidId(userId) &&
                       incoming().userId == userId &&
                       isValidUserProfile(incoming());
      allow update: if isUser(userId) && isValidId(userId) &&
                       incoming().userId == userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming());
      allow delete: if isUser(userId) && isValidId(userId);

    }

    // Private Subcollection - accessible strictly by the profile owner
    // (Used to store verified phone numbers, KYC, private security metadata)
    match /users/{userId}/private/{documentId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // User Notifications Subcollection
    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Public User Index mapping publicUserId -> userId
    match /public_user_indices/{publicUserId} {
      allow get: if isSignedIn() && isValidId(publicUserId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(publicUserId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().publicUserId == publicUserId &&
                       isValidTimestamp(incoming().createdAt);
      allow update: if false;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Likes & Passes
    match /likes/{likeId} {
      allow get, list: if isSignedIn() &&
                          (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(likeId) &&
                       incoming().fromUserId == request.auth.uid &&
                       incoming().type in ['like', 'super_like', 'pass'] &&
                       isValidTimestamp(incoming().createdAt);
      allow update, delete: if false;
    }

    // Matches
    match /matches/{matchId} {
      allow get, list: if isSignedIn() && (request.auth.uid in resource.data.users);
      allow create: if isSignedIn() && isValidId(matchId) &&
                       (request.auth.uid in incoming().users) &&
                       incoming().users.size() == 2 &&
                       isValidTimestamp(incoming().createdAt);
      allow update: if isSignedIn() &&
                       (request.auth.uid in existing().users) &&
                       (request.auth.uid in incoming().users) &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && (request.auth.uid in resource.data.users);

      // Realtime Messages Subcollection
      match /messages/{messageId} {
        allow get, list: if isSignedIn() &&
                            (request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users);
        allow create: if isSignedIn() && isValidId(messageId) &&
                         incoming().senderId == request.auth.uid &&
                         (request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users) &&
                         incoming().text is string && incoming().text.size() <= 2000 &&
                         isValidTimestamp(incoming().createdAt);
        allow update: if isSignedIn() &&
                         (request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status']);
        allow delete: if false;
      }
    }

    // Calls signaling metadata
    match /calls/{callId} {
      allow get, list: if isSignedIn() &&
                          (resource.data.callerUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
      allow create: if isSignedIn() && isValidId(callId) &&
                       incoming().callerUid == request.auth.uid &&
                       incoming().status in ['ringing', 'calling'] &&
                       isValidTimestamp(incoming().createdAt);
      allow update: if isSignedIn() &&
                       (existing().callerUid == request.auth.uid || existing().receiverUid == request.auth.uid) &&
                       incoming().callerUid == existing().callerUid &&
                       incoming().receiverUid == existing().receiverUid;
      allow delete: if isSignedIn() &&
                       (existing().callerUid == request.auth.uid || existing().receiverUid == request.auth.uid);
    }

    // Reports (Write-only for users)
    match /reports/{reportId} {
      allow create: if isSignedIn() && isValidId(reportId) &&
                       incoming().reporterUid == request.auth.uid &&
                       isValidTimestamp(incoming().createdAt);
      allow read, update, delete: if false;
    }

    // Blocks
    match /blocks/{blockId} {
      allow get, list: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow create: if isSignedIn() && isValidId(blockId) &&
                       incoming().blockerUid == request.auth.uid &&
                       isValidTimestamp(incoming().createdAt);
      allow delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }
  }
}
