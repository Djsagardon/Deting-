rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------
    // AUTHENTICATION & OWNERSHIP HELPERS
    // ----------------------------------------------------
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ----------------------------------------------------
    // USER PROFILES & PRIVATE DATA
    // ----------------------------------------------------
    match /users/{userId} {
      // Authenticated users can read profiles for Discovery, Swiping, and Matches.
      // (Sensitive info like raw mobile number is stored separately in the private subcollection)
      allow read: if isSignedIn();

      // Only the authenticated account owner can create their own profile document.
      // Newly registered users are assigned 'user' role by default (or admin if bootstrapped/created by admin).
      allow create: if isOwner(userId)
                    && request.resource.data.userId == userId
                    && request.resource.data.displayName is string
                    && request.resource.data.accountStatus is string
                    && (!('role' in request.resource.data) || request.resource.data.role == 'user' || isAdmin())
                    && (!('age' in request.resource.data) || (request.resource.data.age is int && request.resource.data.age >= 18));

      // Profile updates:
      // - Account owner can update their profile.
      // - Users cannot change their own 'role' field (prevents self-promotion to admin).
      // - Only authorized administrators can alter user roles or account status.
      // - When profileCompleted is true, enforces 5 photos and age >= 18.
      allow update: if (
                      isOwner(userId)
                      && request.resource.data.userId == userId
                      && (!('age' in request.resource.data) || (request.resource.data.age is int && request.resource.data.age >= 18))
                      && (!request.resource.data.profileCompleted || (request.resource.data.profilePhotoUrls.size() == 5 && request.resource.data.age >= 18))
                      && (
                        // Normal user cannot change their own role
                        request.resource.data.role == resource.data.role ||
                        (!('role' in resource.data) && request.resource.data.role == 'user') ||
                        isAdmin()
                      )
                    ) || isAdmin();

      // Account deletion: owner or administrator
      allow delete: if isOwner(userId) || isAdmin();

      // Private user data: strictly accessible by the account owner or administrator
      // Stores raw unmasked mobile numbers, KYC status, and security tokens
      match /private/{documentId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Notifications:
      // The user can read, update (mark read), or delete their own notifications.
      // Other authenticated users can create notifications directed to this user (for likes, matches, or calls).
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        allow create: if isSignedIn() && request.resource.data.userId == userId;
      }
    }

    // ----------------------------------------------------
    // PUBLIC USER INDEX (BDXXXXXX -> userId)
    // ----------------------------------------------------
    match /public_user_indices/{publicUserId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ----------------------------------------------------
    // LIKES & PASSES
    // ----------------------------------------------------
    match /likes/{likeId} {
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.fromUserId == request.auth.uid || isAdmin());
    }

    // ----------------------------------------------------
    // MATCHES & REAL-TIME CONVERSATIONS
    // ----------------------------------------------------
    match /matches/{matchId} {
      function isMatchParticipant() {
        return isSignedIn() && (
          (resource.data.users != null && request.auth.uid in resource.data.users) ||
          (resource.data.participants != null && request.auth.uid in resource.data.participants) ||
          resource.data.user1Id == request.auth.uid ||
          resource.data.user2Id == request.auth.uid ||
          isAdmin()
        );
      }

      // Allow get if document does not exist yet (required for transactions/idempotent checks)
      // or if the caller is a participant in the match
      allow get: if isSignedIn() && (resource == null || isMatchParticipant());

      // Querying matches: participants can query matches containing their UID
      allow list: if isMatchParticipant();

      // Creation: Caller must be one of the matched users
      allow create: if isSignedIn() && (
        (request.resource.data.users != null && request.auth.uid in request.resource.data.users) ||
        (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants) ||
        request.resource.data.user1Id == request.auth.uid ||
        request.resource.data.user2Id == request.auth.uid ||
        isAdmin()
      );

      // Updates (e.g. lastMessage, lastMessageTimestamp) by match participants
      allow update: if isMatchParticipant();
      allow delete: if isMatchParticipant();

      // Messages subcollection within a match
      match /messages/{messageId} {
        function canAccessConversation() {
          return isSignedIn() && (
            (get(/databases/$(database)/documents/matches/$(matchId)).data.users != null &&
             request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users) ||
            (get(/databases/$(database)/documents/matches/$(matchId)).data.participants != null &&
             request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participants) ||
            isAdmin()
          );
        }

        // Only conversation participants can read messages
        allow read: if canAccessConversation();

        // Only conversation participants can send messages, with matching senderId
        allow create: if canAccessConversation()
                      && request.resource.data.senderId == request.auth.uid;

        // Updates (status e.g. read receipts, delete for me, delete for everyone by sender)
        allow update: if canAccessConversation()
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.matchId == resource.data.matchId;

        // Physical deletion prevented to protect message audit log; soft-deletion is enforced
        allow delete: if isAdmin();
      }
    }

    // ----------------------------------------------------
    // VOICE & VIDEO CALL SIGNALING
    // ----------------------------------------------------
    match /calls/{callId} {
      allow read: if isSignedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
                    && request.resource.data.callerUid == request.auth.uid
                    && request.resource.data.receiverUid != request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        isAdmin()
      );
    }

    // ----------------------------------------------------
    // SAFETY: REPORTS & BLOCKS
    // ----------------------------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.reportedUid != request.auth.uid;
      allow read: if isSignedIn() && (resource.data.reporterUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /blocks/{blockId} {
      allow read: if isSignedIn() && (resource.data.blockerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && request.resource.data.blockerUid == request.auth.uid
                    && request.resource.data.blockedUid != request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.blockerUid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // ----------------------------------------------------
    // ADMINISTRATIVE AUDIT LOGS
    // ----------------------------------------------------
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
